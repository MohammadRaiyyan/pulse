# Copy to deploy/.env on the server and fill in every value marked REQUIRED.
# Docker Compose reads this file both for ${...} substitution in compose.production.yml
# and as the environment of the api, worker and migrate containers.

# Public hostname. Point an A record at the server before the first start;
# Caddy then obtains a Let's Encrypt certificate for it automatically.
DOMAIN=pulse.example.com
# Optional overrides. APP_URL defaults to https://$DOMAIN and SITE_ADDRESS to $DOMAIN.
APP_URL=
SITE_ADDRESS=
HTTP_PORT=80
HTTPS_PORT=443

# Images. Leave as is to build on the server; set to ghcr.io/<owner>/pulse-api and
# ghcr.io/<owner>/pulse-web with a commit SHA tag to run images pushed by CI.
PULSE_API_IMAGE=pulse-api
PULSE_WEB_IMAGE=pulse-web
PULSE_TAG=latest

# REQUIRED. openssl rand -base64 48 (run once per variable)
JWT_SECRET=
INVITE_SECRET=
# REQUIRED once secret monitor headers ship. openssl rand -base64 32
ENCRYPTION_KEY=
# Optional, enables GET /metrics on the internal network. openssl rand -hex 32
METRICS_TOKEN=

# REQUIRED. openssl rand -hex 32 (hex keeps it safe inside a URL)
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# Database, option A: PostgreSQL in this stack. Keep the profile line and set a password.
COMPOSE_PROFILES=local-db
POSTGRES_PASSWORD=
# Database, option B: managed PostgreSQL (Neon, RDS). Remove COMPOSE_PROFILES above and set
# DATABASE_URL. Use the direct (non-pooled) URL with sslmode=require. If you use a
# transaction pooler (Neon "-pooler" host, RDS Proxy, PgBouncer), append &prepare=false to
# DATABASE_URL and put the direct URL in DATABASE_MIGRATION_URL.
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Proxy hops in front of the API. 1 = Caddy only. Add one per extra layer (ALB, CloudFront).
TRUST_PROXY=1

# REQUIRED. Email over SMTP (Resend, Brevo, Postmark, Amazon SES, ...)
MAIL_FROM=Pulse <alerts@pulse.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional OAuth sign-in. Callback URLs: https://$DOMAIN/oauth/callback/github and /google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OWNER_SIGNUP_ENABLED=false
ALLOW_PRIVATE_NETWORK_TARGETS=false
LOG_LEVEL=info

# Tuning (defaults shown)
API_RATE_LIMIT_PER_MINUTE=300
MAX_MONITORS_PER_WORKSPACE=100
CHECK_WORKER_CONCURRENCY=20
CHECK_MAX_CONCURRENCY_PER_HOST=4
CHECK_DISPATCH_INTERVAL_MS=15000
SILENCE_CHECK_INTERVAL_MS=60000
WEBHOOK_MAX_BODY_BYTES=262144
WEBHOOK_INGEST_PER_SLUG_PER_MINUTE=120
WEBHOOK_INGEST_PER_IP_PER_MINUTE=600
WEBHOOK_EVENT_RETENTION_DAYS=30
WEBHOOK_MAX_EVENTS_PER_ENDPOINT=1000
LIVE_HEARTBEAT_INTERVAL_MS=25000
LIVE_MAX_CONNECTIONS_PER_USER=5
