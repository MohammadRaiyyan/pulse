NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_URL=http://localhost:5173
APP_VERSION=dev
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
INVITE_SECRET=replace-with-another-output-of-openssl-rand-base64-48
COOKIE_SECURE=
TRUST_PROXY=loopback
METRICS_TOKEN=
OWNER_SIGNUP_ENABLED=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_RATE_LIMIT_PER_MINUTE=300
CHECK_DISPATCH_INTERVAL_MS=15000
SILENCE_CHECK_INTERVAL_MS=60000
ALLOW_PRIVATE_NETWORK_TARGETS=true
MAX_MONITORS_PER_WORKSPACE=100
CHECK_WORKER_CONCURRENCY=20
CHECK_MAX_CONCURRENCY_PER_HOST=4
WEBHOOK_MAX_BODY_BYTES=262144
WEBHOOK_INGEST_PER_SLUG_PER_MINUTE=120
WEBHOOK_INGEST_PER_IP_PER_MINUTE=600
WEBHOOK_EVENT_RETENTION_DAYS=30
WEBHOOK_MAX_EVENTS_PER_ENDPOINT=1000
LIVE_HEARTBEAT_INTERVAL_MS=25000
LIVE_MAX_CONNECTIONS_PER_USER=5
MAIL_TRANSPORT=smtp
MAIL_FILE=
MAIL_FROM="Pulse <alerts@pulse.localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
