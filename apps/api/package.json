{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --env-file=.env src/server.ts",
    "worker": "NODE_ENV=development node --watch --env-file=.env src/worker.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "start:worker": "node --env-file-if-exists=.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env src/db/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "catalog:",
    "@pulse/contracts": "workspace:*",
    "bullmq": "catalog:",
    "cookie-parser": "catalog:",
    "cors": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "ipaddr.js": "catalog:",
    "jose": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "postgres": "catalog:",
    "prom-client": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
